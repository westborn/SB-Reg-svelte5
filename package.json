		"@supabase/supabase-js": "^2.98.0",
		"cloudinary": "^2.8.0",
		"clsx": "^2.1.1",
		"cmdk-sv": "^0.0.19",
		"glob": "^10.5.0",
		"json-to-csv-export": "^3.1.0",
		"lucide-svelte": "^0.456.0",
		"nodemailer": "^7.0.11",
		"pg": "^8.19.0",
		"runed": "^0.23.2",
		"square": "^43.2.1",
		"svelte-cloudinary": "^2.3.0",
		"sveltekit-superforms": "^2.30.0",
		"tailwind-animate": "^0.2.10",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"zod-prisma-types": "^3.2.3"
	}
}
