{
	"name": "sb-reg-svelte5",
	"version": "1.9.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/westborn/SB-Reg-svelte5"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"netlify-build": "prisma generate && pnpm run build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev && prisma generate",
		"db:reset": "prisma migrate reset --force && prisma generate && prisma db seed",
		"db:seed": "prisma db seed",
		"studio": "prisma studio",
		"upgrade-deps": "ncu -uis --format group --install always",
		"bump:patch": "npm --no-git-tag-version version patch",
		"bump:minor": "npm --no-git-tag-version version minor",
		"bump:major": "npm --no-git-tag-version version major"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.3",
		"@exodus/schemasafe": "^1.3.0",
		"@faker-js/faker": "^9.4.0",
		"@lucide/svelte": "^0.482.0",
		"@sinclair/typebox": "^0.34.48",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/kit": "^2.53.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/postcss": "^4.2.1",
		"@tanstack/svelte-table": "9.0.0-alpha.10",
		"@types/eslint": "^9.6.1",
		"@types/nodemailer": "^7.0.11",
		"@typeschema/class-validator": "^0.3.0",
		"@vinejs/vine": "^1.8.0",
		"arktype": "^2.1.29",
		"autoprefixer": "^10.4.27",
		"bits-ui": "^2.16.2",
		"class-validator": "^0.14.1",
		"embla-carousel-svelte": "8.1.6",
		"eslint": "^9.39.3",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-svelte": "^2.46.1",
		"formsnap": "2.0.1",
		"globals": "^15.15.0",
		"joi": "^17.13.3",
		"mode-watcher": "^1.1.0",
		"paneforge": "1.0.0-next.6",
		"postcss": "^8.5.8",
		"postcss-load-config": "^6.0.1",
		"prettier": "^3.8.1",
		"prettier-plugin-prisma": "^5.0.0",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"prisma": "^7.4.2",
		"superstruct": "^2.0.2",
		"svelte": "^5.53.7",
		"svelte-check": "^4.4.4",
		"svelte-sonner": "^0.3.28",
		"tailwindcss": "^4.2.1",
		"tslib": "^2.8.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"valibot": "^1.2.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^7.3.1",
		"yup": "^1.6.1",
		"zod": "^4.1.13"
	},
	"type": "module",
	"pnpm": {
		"overrides": {
			"valibot": "^1.2.0",
			"validator": "^13.15.22"
		}
	},
	"dependencies": {
		"@prisma/client": "^7.4.2",
