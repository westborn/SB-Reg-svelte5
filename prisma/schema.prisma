generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model artistTable {
  id              Int                 @id @default(autoincrement())
  email           String              @unique
  firstName       String              @map("first_name")
  lastName        String              @map("last_name")
  phone           String
  postcode        String
  firstNations    Indigenous          @default(No) @map("first_nations")
  bankAccountName String?             @map("bank_account_name")
  bankBSB         String?             @map("bank_bsb")
  bankAccount     String?             @map("bank_account")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime            @updatedAt @map("updated_at")
  entries         entryTable[]
  images          imageTable[]
  registrations   registrationTable[]

  @@map("artist")
}

model registrationTable {
  id                  Int                       @id @default(autoincrement())
  artistId            Int                       @map("artist_id")
  registrationYear    String                    @map("registration_year")
  registrationState   RegistrationState         @default(Draft) @map("registration_state")
  closed              Boolean                   @default(false)
  bumpIn              String?                   @map("bump_in")
  bumpOut             String?                   @map("bump_out")
  displayRequirements String?                   @map("display_requirements")
  accommodation       Boolean                   @default(false)
  crane               Boolean                   @default(false)
  transport           Boolean                   @default(false)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  entries             entryTable[]
  images              imageTable[]
  artist              artistTable               @relation(fields: [artistId], references: [id], onDelete: Cascade)
  payment             registrationPaymentTable?

  @@unique([artistId, registrationYear], map: "registration_artist_id_registration_year_key")
  @@map("registration")
}

model registrationPaymentTable {
  id                      Int               @id @default(autoincrement())
  registrationId          Int               @unique @map("registration_id")
  paymentState            PaymentState      @default(Unpaid) @map("payment_state")
  feeInCents              Int               @map("fee_in_cents")
  paymentAttemptKey       String?           @unique @map("payment_attempt_key")
  squarePaymentId         String?           @unique @map("square_payment_id")
  squareLocationId        String?           @map("square_location_id")
  currency                String?           @db.VarChar(3)
  receiptURL              String?           @map("receipt_url")
  resolvedAt              DateTime?         @map("resolved_at") @db.Timestamp(6)
  confirmationEmailSentAt DateTime?         @map("confirmation_email_sent_at") @db.Timestamp(6)
  confirmationEmailError  String?           @map("confirmation_email_error") @db.Text
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime          @updatedAt @map("updated_at")
  registration            registrationTable @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([paymentState, updatedAt], map: "registration_payment_state_updated_at_idx")
  @@map("registration_payment")
}

model entryTable {
  id                  Int                @id @default(autoincrement())
  artistId            Int                @map("artist_id")
  accepted            Boolean            @default(false)
  registrationId      Int                @map("registration_id")
  description         String?
  dimensions          String?
  enterMajorPrize     Boolean            @default(false) @map("enter_major_prize")
  inOrOut             EntryType          @map("in_or_out")
  material            String?
  price               Int                @map("price_in_cents")
  sold                Boolean            @default(false)
  specialRequirements String?            @map("special_requirements")
  title               String
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime           @updatedAt @map("updated_at")
  artist              artistTable        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  registration        registrationTable  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  images              imageTable[]
  location            locationTable?
  primaryImage        primaryImageTable?

  @@map("entry")
}

model imageTable {
  id                   Int                 @id @default(autoincrement())
  artistId             Int                 @map("artist_id")
  registrationId       Int?                @map("registration_id")
  entryId              Int?                @map("entry_id")
  cloudId              String              @map("cloud_id")
  cloudURL             String              @map("cloud_url")
  originalFileName     String              @map("original_file_name")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime            @updatedAt @map("updated_at")
  artist               artistTable         @relation(fields: [artistId], references: [id], onDelete: Cascade)
  entry                entryTable?         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  registration         registrationTable?  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  primaryImageRelation primaryImageTable[]

  @@map("image")
}

model locationTable {
  id            Int        @id @default(autoincrement())
  exhibitNumber String     @map("exhibit_number")
  entryId       Int        @unique @map("entry_id")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime   @updatedAt @map("updated_at")
  entry         entryTable @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("location")
}

model primaryImageTable {
  id        Int        @id @default(autoincrement())
  entryId   Int        @unique @map("entry_id")
  imageId   Int        @map("image_id")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime   @updatedAt @map("updated_at")
  entry     entryTable @relation(fields: [entryId], references: [id], onDelete: Cascade)
  image     imageTable @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@map("primary_image")
}

model logTable {
  id        Int      @id @default(autoincrement())
  level     LogLevel
  message   String
  context   Json?
  userId    String?  @map("user_id")
  routeId   String?  @map("route_id")
  error     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([level, createdAt])
  @@map("log")
}

enum Indigenous {
  Yes
  No
  Declined

  @@map("indigenous")
}

enum EntryType {
  Indoor
  Outdoor

  @@map("entry_type")
}

enum RegistrationState {
  Draft     @map("draft")
  Submitted @map("submitted")

  @@map("registration_state")
}

enum PaymentState {
  Unpaid      @map("unpaid")
  Processing  @map("processing")
  Paid        @map("paid")
  Waived      @map("waived")
  NeedsReview @map("needs_review")

  @@map("payment_state")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR

  @@map("log_level")
}
